        {
            "caption": "define frequency domain solver parameters",
            "version": "2026.5|35.0.0|20260618",
            "hidden": false,
            "type": "vba",
            "code": [
                "Mesh.SetCreator \"High Frequency\" ",
                "",
                "With FDSolver",
                "     .Reset ",
                "     .SetMethod \"Tetrahedral\", \"General purpose\" ",
                "     .OrderTet \"Second\" ",
                "     .OrderSrf \"First\" ",
                "     .Stimulation \"All\", \"All\" ",
                "     .ResetExcitationList ",
                "     .AutoNormImpedance \"True\" ",
                "     .NormingImpedance \"50\" ",
